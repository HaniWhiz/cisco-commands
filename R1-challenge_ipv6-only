R1
===========
en
conf t
host DC1-R1
no ip domain lookup
ipv6 unicast-routing


ipv6 route 2001:db8:1::/48 Null0           ! anchors the aggregate for BGP



int loo 0
description Underlay
ipv6 add 2001:db8:1:ffff::1/128
ipv6 router isis
exit


interface Gi1
 description to R2-Port1
 no ip address
 channel-group 1 mode active
 no sh
 exit


interface Gi2
 description R2-Port2
 no ip address
 channel-group 1 mode active
 no sh
 exit

int Gi3
description ISP-A
ipv6 add fd15:1::b/127
no sh
exit

int Gi4
description ISP-B
ipv6 add fd16:1::b/127
no sh
exit

int Gi5
description Internal-Core
ipv6 add 2001:db8:1:dc1::170a/127
ipv6 router isis
isis network point-to-point
no sh
exit


interface Port-channel1
 description LACP bundle to DC1-R2 (iBGP + IS-IS)
 ipv6 address 2001:db8:1:dc1::120a/127
 ipv6 router isis
 isis network point-to-point
 no sh
 exit


router isis
net 49.0001.0000.0000.0001.00
log-adjacency-changes
is-type level-2-only
metric-style wide
passive-interface loopback 255
advertise passive-only
address-family ipv6
multi-topology
exit
exit

router bgp 1.1
bgp asnotation dot
no bgp default ipv4-unicast
bgp log-neighbor-changes

bgp router-id 1.1.1.1

neighbor 2001:db8:1:ffff::2 remote-as 1.1
neighbor 2001:db8:1:ffff::2 update-source loopback 255
neighbor 2001:db8:1:ffff::3 remote-as 1.1
neighbor 2001:db8:1:ffff::3 update-source loopback 255
neighbor 2001:db8:1:ffff::4 remote-as 1.1
neighbor 2001:db8:1:ffff::4 update-source loopback 255
neighbor fd15:1::a remote-as 1.2
neighbor fd15:1::a update-source loopback 255
neighbor fd16:1::a remote-as 1.3
neighbor fd16:1::a update-source loopback 255
neighbor 2001:db8:1:ffff::7 remote-as 1.1
neighbor 2001:db8:1:ffff::7 update-source loopback 255


address-family ipv6 unicast
  neighbor fd15:1::a activate
  neighbor fd15:1::a route-map OUR-PREFIX-OUT out
  neighbor fd16:1::a activate
  neighbor fd16:1::a route-map OUR-PREFIX-OUT out
network 2001:db8:1:dc1::/64
redistribute connected
neighbor 2001:db8:1:ffff::2 activate
neighbor 2001:db8:1:ffff::3 activate
neighbor 2001:db8:1:ffff::4 activate
neighbor 2001:db8:1:ffff::7 activate


exit


end
